server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location = /api/health {
        proxy_pass http://backend:5000/api/health;
        proxy_set_header Host $host;
    }

    location ^~ /gateway/api/ {
        rewrite ^/gateway(/api/.*)$ $1 break;
        proxy_pass http://backend:5000;
        proxy_set_header Host $host;
        proxy_set_header X-API-Key ${FRONTEND_API_KEY};
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
