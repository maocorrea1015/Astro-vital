# ==============================================================================
# ASTRA HEALTH BACKEND - CONFIGURACIÓN DE ENTORNO (.env)
# ==============================================================================
# ADVERTENCIA: Nunca subas este archivo con credenciales de producción al repositorio.
# Copia este archivo como .env y ajusta los valores para tu entorno.

# Entorno de ejecución: development | production | testing
FLASK_ENV=development

# Clave secreta para sesiones internas de Flask y tokens criptográficos
# Generar una con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar_esta_clave_secreta_en_produccion_astra_health_2026

# Host y Puerto del servidor
HOST=0.0.0.0
PORT=5000

# Ruta absoluta o relativa al archivo de base de datos SQLite
DATABASE_PATH=data/astra_health.db

# Ventana y límite de Rate Limiting (por API Key)
# Límite máximo de solicitudes permitidas dentro de la ventana de tiempo
RATE_LIMIT_MAX_REQUESTS=100
# Ventana de tiempo en segundos
RATE_LIMIT_WINDOW_SECONDS=60

# Umbral en segundos para considerar un astronauta/nodo 'online' o 'offline'
ASTRONAUT_TIMEOUT_SECONDS=60

# Nivel de logging para consola: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL_CONSOLE=INFO

# Nivel de logging para archivo: WARNING, ERROR, CRITICAL
LOG_LEVEL_FILE=WARNING

# Habilitar cabecera Strict-Transport-Security (solo si se sirve bajo HTTPS)
ENABLE_HSTS=false
